# Build output
target/
build/
out/

# Maven wrapper jar (should not be committed)
.mvn/wrapper/maven-wrapper.jar

# Logs
*.log

# JVM crash logs
hs_err_pid*
replay_pid*

# OS generated files
.DS_Store
Thumbs.db

# IDE — IntelliJ
.idea/
*.iml
*.ipr
*.iws

# IDE — Eclipse / STS
.classpath
.project
.settings/
.springBeans
.sts4-cache

# IDE — VS Code
.vscode/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Temporary files
*.tmp
*.swp

# Archives
*.zip
*.tar
*.tar.gz
*.rar

# Ignore generated HELP documentation
HELP.md

# Allow build folders inside source directories (rare case)
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/